# ---- Database (Neon / Supabase / Render Postgres - all have a free tier) ----
# Neon example:  postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/paisa?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth ----
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional: lock down who can create an account (comma separated emails).
# Leave empty to allow anyone to register.
ALLOWED_EMAILS=""

# Optional: seeded demo login
SEED_EMAIL="demo@paisa.app"
SEED_PASSWORD="demo1234"
