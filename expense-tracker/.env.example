# ---- Database (MongoDB Atlas has a free M0 tier that never expires) ----
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/paisa
# Local:  mongodb://localhost:27017/paisa
#
# Include the database name after the host. Without it everything lands in a
# database called "test".
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/paisa"

# ---- Auth ----
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional: lock down who can create an account (comma separated emails).
# Leave empty to allow anyone to register.
ALLOWED_EMAILS=""

# Optional: seeded demo login
SEED_EMAIL="demo@paisa.app"
SEED_PASSWORD="demo1234"
