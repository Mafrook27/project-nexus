{
  "name": "paisa",
  "version": "1.0.0",
  "private": true,
  "description": "Paisa - personal expense, savings, investment and FIRE tracker",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "tsx --conditions=react-server scripts/setup.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --conditions=react-server src/server/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server src/server/db/seed.ts",
    "db:reset": "tsx --conditions=react-server src/server/db/migrate.ts --reset",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "parse": "tsx scripts/parse-sms.ts",
    "db:check": "tsx --conditions=react-server src/server/db/check.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.5",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mingo": "^7.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.14",
    "typescript": "^5.9.3"
  }
}
